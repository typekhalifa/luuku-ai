generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String              @id @default(uuid())
  email        String              @unique
  name         String
  passwordHash String
  status       UserStatus           @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  memberships  CompanyMembership[]
  sessions     Session[]
  @@index([status])
}

model CompanyMembership {
  id        String         @id @default(uuid())
  userId    String
  companyId String
  role      MembershipRole
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([userId, companyId])
  @@index([companyId, role])
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Company {
  id         String        @id @default(uuid())
  name       String        @unique
  industry   String
  website    String?
  country    String
  city       String?
  size       CompanySize?
  status     CompanyStatus
  confidence Int
  verified   Boolean
  source     String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  activities Activity[]
  contacts   Contact[]
  deals      Deal[]
  workflows  Workflow[]
  communicationConversations CommunicationConversation[]
  communicationExecutions CommunicationExecution[]
  communicationEvents CommunicationEvent[]
  memberships CompanyMembership[]
  executiveObjectives ExecutiveObjective[]
  executiveMemories ExecutiveMemory[]
  institutionalMemories ExecutiveInstitutionalMemory[]
  executiveCheckpoints ExecutiveLoopCheckpoint[]
  executiveEventInboxes ExecutiveEventInbox[]
}

model Contact {
  id                String     @id @default(uuid())
  companyId         String
  name              String
  email             String?
  phoneNumber       String?
  preferredLanguage String?
  department        String?
  position          String?
  verified          Boolean
  confidence        Int
  source            String
  lastVerifiedAt    DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  activities        Activity[]
  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId])
}

model Deal {
  id                String     @id @default(uuid())
  companyId         String
  title             String
  value             Float
  currency          String
  stage             DealStage
  probability       Int
  ownerAgentId      String
  nextAction        String
  dueDate           DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  expectedCloseDate DateTime?
  lastActivityAt    DateTime?
  activities        Activity[]
  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId])
}

model Activity {
  id          String       @id @default(uuid())
  companyId   String
  contactId   String?
  dealId      String?
  type        ActivityType
  title       String
  description String
  outcome     String?
  createdBy   String
  completed   Boolean      @default(false)
  dueAt       DateTime?
  createdAt   DateTime     @default(now())
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact?    @relation(fields: [contactId], references: [id])
  deal        Deal?       @relation(fields: [dealId], references: [id])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([dueAt])
}

model CommunicationConversation {
  id           String                 @id @default(uuid())
  ownershipScope String?
  companyId    String?
  spaceId      String?
  channel      String
  threadKey    String?                @unique
  status       String                 @default("active")
  participants Json
  metadata     Json?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  messages     CommunicationMessage[]
  events       CommunicationEvent[]
  executions   CommunicationExecution[]
  company      Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  @@index([companyId])
  @@index([spaceId])
  @@index([ownershipScope])
  @@index([channel])
  @@index([status])
}

model CommunicationMessage {
  id                String                    @id @default(uuid())
  conversationId    String
  direction         String
  role              String
  content           String
  sender            Json
  externalMessageId String?
  timestamp         DateTime                  @default(now())
  metadata          Json?
  conversation      CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId])
  @@index([externalMessageId])
  @@unique([conversationId, externalMessageId])
}

model CommunicationEvent {
  id              String                     @id @default(uuid())
  ownershipScope  String?
  companyId       String?
  spaceId         String?
  provider        String
  providerEventId String                     @unique
  type            String
  externalId      String?
  messageId       String?
  conversationId  String?
  recipient       String?
  sender          String?
  subject         String?
  payload         Json
  receivedAt      DateTime                   @default(now())
  conversation    CommunicationConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  company         Company?                    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  @@index([companyId])
  @@index([spaceId])
  @@index([ownershipScope])
  @@index([externalId])
  @@index([messageId])
  @@index([conversationId])
  @@index([type])
}

model CommunicationExecution {
  id                String                     @id @default(uuid())
  ownershipScope   String?
  companyId         String?
  spaceId           String?
  conversationId    String?
  taskId            String?
  idempotencyKey    String?
  capability        String
  channel           String
  recipient         Json?
  audience          String?
  executionMode     String?
  policyDecision    String
  policyReason      String
  status            String
  executed          Boolean                    @default(false)
  verified          Boolean                    @default(false)
  provider          String?
  externalId        String?
  evidence          Json?
  error             String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  conversation      CommunicationConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  company           Company?                    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  @@index([companyId])
  @@index([spaceId])
  @@index([ownershipScope])
  @@index([conversationId])
  @@index([taskId])
  @@index([status])
  @@index([createdAt])
  @@index([provider])
  @@unique([idempotencyKey])
}

model Workflow {
  id                    String         @id
  ownershipScope        String?
  companyId             String?
  goal                  String
  status                String
  requiresFounderApproval Boolean      @default(false)
  approvedAt            DateTime?
  metadata              Json
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  steps                 WorkflowStep[]
  queueItems            QueueItem[]
  company               Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  @@index([status])
  @@index([companyId])
  @@index([ownershipScope])
}

model WorkflowStep {
  id                String   @id
  workflowId        String
  title             String
  description       String
  agentId           String
  capability        String?
  dependsOn         Json
  priority          String
  requiresApproval  Boolean  @default(false)
  status            String
  input             Json?
  output            Json?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  workflow          Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  @@index([workflowId])
  @@index([status])
  @@index([agentId])
}

model QueueItem {
  id          String   @id
  workflowId  String
  stepId      String
  agentId     String
  priority    String
  availableAt DateTime
  status      String
  attempts    Int      @default(0)
  metadata    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  @@index([status, availableAt])
  @@index([priority, availableAt])
  @@index([workflowId])
  @@index([stepId])
}

model ExecutiveLoopCheckpoint {
  id                String   @id
  ownershipScope    String   @default("SYSTEM")
  companyId         String?
  version           Int      @default(1)
  handledIntentKeys Json
  cycleCount        Int      @default(0)
  updatedAt         DateTime
  company            Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  @@index([companyId])
  @@index([ownershipScope])
}

model ExecutiveEventInbox {
  id                  String   @id
  ownershipScope     String   @default("SYSTEM")
  companyId          String?
  type                String
  occurredAt          DateTime @default(now())
  metadata            Json?
  status              String   @default("PENDING")
  attempts            Int      @default(0)
  processingStartedAt DateTime?
  deliveredAt         DateTime?
  lastError           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  company             Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  @@index([status, occurredAt])
  @@index([companyId, status, occurredAt])
  @@index([ownershipScope])
  @@index([processingStartedAt])
}

model ExecutiveObjective {
  id               String   @id
  ownershipScope   String   @default("SYSTEM")
  companyId        String?
  title            String
  description      String
  priority         String
  status           String   @default("ACTIVE")
  progress         Int      @default(0)
  previousProgress Int?
  deadlineAt       DateTime?
  staleAfterDays   Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  company          Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  @@index([status, priority])
  @@index([companyId, status, priority])
  @@index([ownershipScope])
}

model ExecutiveMemory {
  id             String   @id
  ownershipScope String   @default("SYSTEM")
  companyId      String?
  objectiveId    String?
  workflowId     String?
  eventType      String
  action         String
  outcome        String
  success        Boolean
  lesson         String?
  confidence     Float?
  createdAt      DateTime
  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  @@index([objectiveId, createdAt])
  @@index([workflowId, createdAt])
  @@index([eventType, createdAt])
  @@index([action, createdAt])
  @@index([companyId, createdAt])
  @@index([ownershipScope])
}

model ExecutiveInstitutionalMemory {
  id              String   @id
  ownershipScope  String   @default("SYSTEM")
  companyId       String?
  kind            String
  subject         String
  statement       String
  confidence      Float
  evidenceIds     String[]
  objectiveIds    String[]
  active          Boolean
  firstObservedAt DateTime
  lastConfirmedAt DateTime
  company         Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  @@index([kind, active])
  @@index([companyId, active])
  @@index([ownershipScope])
  @@index([subject])
  @@index([confidence])
  @@index([lastConfirmedAt])
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum CompanyStatus {
  prospect
  qualified
  customer
  inactive
}

enum CompanySize {
  startup
  small
  medium
  enterprise
}

enum DealStage {
  lead
  qualified
  discovery
  proposal
  negotiation
  won
  lost
}

enum ActivityType {
  call
  email
  meeting
  note
  task
}
