# Voice provider
# Keep simulation until you are ready for a real outbound call.
VOICE_MODE=simulation

# Safety: when set, live calls are restricted to these E.164 recipients.
# Example: VOICE_ALLOWED_RECIPIENTS=+2507XXXXXXXX
VOICE_ALLOWED_RECIPIENTS=

# ElevenLabs Conversational AI + Twilio native integration
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=


# API / production
# Bind the API port through the deployment environment.
PORT=3000

# Comma-separated browser origins allowed by the API in production.
# Example: CORS_ORIGINS=https://mission-control.example.com
CORS_ORIGINS=

# Required for production API access. Clients send x-luuku-api-key.
LUUKU_API_KEY=

# Tenant bound to the authenticated API key. Required in production.
# This must be an existing Company.id; never accept tenant identity from the browser.
LUUKU_API_COMPANY_ID=

# Mission Control user bootstrap (run the bootstrap script once; do not commit real credentials)
LUUKU_AUTH_BOOTSTRAP_EMAIL=
LUUKU_AUTH_BOOTSTRAP_PASSWORD=
LUUKU_AUTH_BOOTSTRAP_NAME=
LUUKU_AUTH_BOOTSTRAP_COMPANY_ID=
